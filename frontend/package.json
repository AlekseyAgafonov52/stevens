{
  "name": "stevens-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode minimal",
    "build": "tsc -b && vite build",
    "build:minimal": "tsc -b && vite build --mode minimal",
    "build:full": "tsc -b && vite build --mode full",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-serif": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
