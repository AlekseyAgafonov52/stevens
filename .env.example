# Необязательно. Скопируйте в .env рядом с docker-compose.yml и впишите ключи Yandex Cloud (AI Studio).
# Без ключей чат работает на правилах (app/nlu.py). С ключами YandexGPT подключается
# для фраз, которые правила не поняли.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Адреса основного и запасного фронтенда, через запятую; localhost разрешен по умолчанию.
STEVENS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
# На публичном стенде оставлять 1; 0 только для локальных регрессионных прогонов.
STEVENS_RATE_LIMIT=1
# Только точные IP доверенных reverse proxy. По умолчанию forwarded-заголовки игнорируются.
STEVENS_TRUSTED_PROXIES=
