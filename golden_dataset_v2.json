{
  "meta": {
    "name": "Golden dataset — голосовой ассистент «Стивенс»",
    "version": "2.0",
    "basis": "Основано на сценариях аналитика команды.",
    "contract": "Контракт фронт ↔ бэк v1.2",
    "test_clock": {
      "client_time": "2026-10-21T10:00:00+03:00",
      "timezone": "Europe/Moscow",
      "note": "Среда, 21 окт 2026, 10:00. От этого момента считаются все относительные даты — результаты воспроизводимы (Р-138)."
    },
    "test_data": "with_test_data верно, если загружен CSV организаторов (Р-22) и тип записей угадан по первому слову: «Встреча», «Созвон», «Демо» → встреча (О-01). Иначе сверяйте только kind и template.",
    "isolation": "Каждый кейс запускается на чистых данных (только CSV) и с новым conversation_id; шаги диалога — в одном conversation_id. Иначе записи, созданные одним кейсом, дадут конфликт в другом.",
    "expected_parse_schema": {
      "intent": "create | list | search | help | thanks | off_topic | unknown",
      "type": "task | reminder | meeting — для create",
      "text": "текст записи для сохранения: с заглавной буквы, без командных слов и без даты/времени",
      "date": "относительный токен (today, tomorrow, day_after_tomorrow, yesterday, monday…sunday, end_of_week) или ISO-дата; конкретную дату считает бэк",
      "date_kind": "deadline | none — если не exact (по умолчанию exact)",
      "time": "HH:MM; time_ambiguous: true — если неясно утро или вечер",
      "period": "для list и неточных сроков: today, tomorrow, this_week, next_week, last_friday или ISO-дата",
      "filter_type": "task | reminder | meeting — если спрашивают про один тип",
      "people / organizations / topic / keyword": "имена в начальной форме («Иван», а не «Иваном»), компании, тема, ключевое слово для поиска",
      "ask": "when — спрашивают «когда?»; exists — «есть ли?»",
      "tense": "past | future — для вопросов «когда была / когда будет»",
      "missing": "чего не хватает для действия: time, date, person_or_topic — определяет уточнение",
      "confidence": "high — понял однозначно; low — переспросить «правильно понял?» или «не понял»"
    },
    "how_to_use": {
      "ИИ-модуль": "сравнивать выход LLM с expected_parse.",
      "бэкенд": "прогонять фразы через POST /api/chat с тестовыми часами и сравнивать с expected_response.",
      "фронтенд": "те же фразы — для моков и ручной проверки интерфейса."
    }
  },
