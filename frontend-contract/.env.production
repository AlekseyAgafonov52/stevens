# Сборка для порта 8081 (docker compose): настоящий бэк, вход и все допы включены.
# VITE_API_URL пусто — тот же адрес, что у страницы (nginx проксирует /api на бэк).
VITE_API_MODE=real
VITE_API_URL=
VITE_FEATURE_AUTH=true
VITE_FEATURE_D2_DELETE=true
VITE_FEATURE_D3_COMPLETE=true
VITE_FEATURE_D6_CALENDAR=true
VITE_FEATURE_D10_UNDO=true
VITE_FEATURE_D12_SPEECH=true
VITE_FEATURE_D13_AUTOLISTEN=true
VITE_FEATURE_D14_MASCOT=true
VITE_FEATURE_D15_TOUR=true
